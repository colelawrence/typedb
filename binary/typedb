set -euo pipefail

# Resolve symlinks to find the real script location
if command -v realpath &> /dev/null; then
    SCRIPT_PATH=$(realpath "$0")
else
    SCRIPT_PATH="$0"
fi
TYPEDB_HOME=$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)

print_usage() {
    echo "Usage: typedb <command> [options]"
    echo ""
    echo "Commands:"
    echo "  server    Start the TypeDB server"
    echo ""
    echo "Run 'typedb server --help' for server options."
}

case "${1:-}" in
    server)
        TYPEDB_SERVER_BIN="${TYPEDB_HOME}/server/typedb_server_bin"
        exec "$TYPEDB_SERVER_BIN" "${@:2}"
        ;;
    -h|--help|help)
        print_usage
        exit 0
        ;;
    "")
        print_usage
        exit 1
        ;;
    *)
        echo "Error: Unknown command '$1'"
        echo ""
        print_usage
        exit 1
        ;;
esac
