{
  "name": "@typedb/embedded-node",
  "version": "0.1.0",
  "description": "TypeDB embedded database - Node-API native bindings",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./errors": {
      "types": "./errors.d.ts",
      "default": "./errors.js"
    }
  },
  "scripts": {
    "build": "napi build --platform --release --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform",
    "test": "bun test",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "napi": {
    "binaryName": "typedb-node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "license": "MPL-2.0",
  "devDependencies": {
    "@napi-rs/cli": "^3.5.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "errors.js",
    "errors.d.ts",
    "*.node"
  ],
  "keywords": [
    "typedb",
    "database",
    "embedded",
    "native",
    "napi",
    "node-api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/typedb/typedb"
  },
  "engines": {
    "node": ">= 18"
  }
}
